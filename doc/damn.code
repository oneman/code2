  mpz_clear(c);
  mpz_clear(d);
  mpz_clear(r);
  mpz_clear(r2);
  mpz_clear(e);
  mpz_clear(f);
  mpz_clear(g);
  T = time(0);
  R = snprintf(L, 80, "* hid scan %s", ctime(&T));
  write(1, L, R);
  
  
  
  
  
